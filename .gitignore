# ──────────────────────────────────────────────────────────────────────────────
# StressLine — .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── SECRETS (NEVER commit these) ─────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env
frontend/.env.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.log

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
backend/.venv/
backend/venv/

# ── Hugging Face model caches (can be many GB) ────────────────────────────────
backend/hf-cache/
backend/hf-models/
backend/.hf-cache/
backend/.hf-models/
*.pt
*.bin
*.safetensors
*.ckpt

# ── Audio uploads (user data, temp files) ─────────────────────────────────────
backend/uploads/
backend/seg30plain/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
.eslintcache

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
*.tgz

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/settings.json
*.suo
*.user

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
